{
  "id": "T4",
  "juego": {
    "oponente": "aleatorio",
    "agente_empieza": true,
    "letra_agente": "X"
  },
  "descripcion": "DQN, LLM evalúa solo el resultado al final de la partida",
  "agente": "dqn",
  "recompensa": {
    "fuente": "llm",
    "directiva": "replica_resultado",
    "cuando": "fin_partida",
    "valores": {
      "gana": 1.0,
      "empate": 0.0,
      "pierde": -1.0
    }
  },
  "llm": {
    "proveedor": "deepinfra",
    "base_url": "https://api.deepinfra.com/v1/openai",
    "modelo": "meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo",
    "temperatura": 0.0,
    "max_tokens": 10,
    "reintentos": 3,
    "fallback": 0.0,
    "api_key_env": "DEEPINFRA_API_KEY"
  },
  "qlearning": null,
  "dqn": {
    "red": "mlp",
    "gamma": 0.99,
    "lr": 0.001,
    "batch": 64,
    "buffer": 100000,
    "inicio_aprendizaje": 1000,
    "entrenar_cada": 1,
    "copia_red_objetivo": 1000,
    "eps_inicio": 1.0,
    "eps_fin": 0.05,
    "eps_pasos": 30000,
    "double_dqn": true,
    "clip_gradiente": 10.0
  },
  "entrenamiento": {
    "epocas": 100,
    "episodios_por_epoca": 100,
    "semilla": 42,
    "determinista": true,
    "checkpoint_cada": 10
  },
  "evaluacion": {
    "cada_epoca": true,
    "partidas": 100,
    "semilla_prueba": 123,
    "greedy": true
  }
}
